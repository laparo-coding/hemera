# Ensure consistent lockfile across npm versions.
# CI resolves Node 24 from .nvmrc (bundled npm >= 11.11); local dev may use
# newer versions. save-exact prevents unintended caret/tilde ranges.
#
# IMPORTANT: npm <= 11.10 strips "libc" fields (musl/glibc guards) from
# package-lock.json on any regen (arborist pkgMetaKeys omission, fixed in
# npm 11.11). Regenerate lockfiles with npm >= 11.11, e.g.:
#   npx npm@11.21.0 install --package-lock-only
# Otherwise installs on Alpine (musl) or glibc images can pick wrong binaries.
# engines.npm in package.json (>=11.11.0) warns on older npm; CI's bundled
# npm satisfies it, so installs only fail where the bug actually exists.
save-exact=true
